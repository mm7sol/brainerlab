# BrainerLab — environment template (PUBLIC, no real secrets here).
# Copy to .env.local for local dev, or set these in Vercel Dashboard
# (Project > Settings > Environment Variables). All are OPTIONAL:
# without them the app runs with local-file storage.
#
# Get values free at: Upstash Console (https://console.upstash.com)
# or Vercel Dashboard > Storage > Create > KV (auto-injects them).

# Upstash/Vercel-KV REST endpoint (read/write)
KV_REST_API_URL=
# Upstash/Vercel-KV REST token (read/write) — NEVER commit a real one
KV_REST_API_TOKEN=
# Read-only token (optional, unused by the app today)
KV_REST_API_READ_ONLY_TOKEN=
# Redis URL (optional, unused by the app today)
REDIS_URL=
